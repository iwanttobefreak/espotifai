# Token de administración de la API. CAMBIA ESTE VALOR.
# Sin él, y sin usuarios creados, la API queda abierta a cualquiera.
API_TOKEN=cambia-este-token

# Carpeta del host con la música (relativa al docker-compose o absoluta)
MUSIC_DIR=./music

# Puerto publicado en el host
PORT=8088

# Carpetas a excluir del escaneo, separadas por coma (opcional)
EXCLUDE_DIRS=
