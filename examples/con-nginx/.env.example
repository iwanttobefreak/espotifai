# CAMBIA ESTE TOKEN antes de arrancar.
API_TOKEN=cambia-este-token

# Carpeta del host con la música (relativa a este directorio o absoluta)
MUSIC_DIR=./music

# Dominio configurado en nginx.conf (informativo; el compose no lo usa)
DOMAIN=micasa.espotifai.es

# Carpetas a excluir del escaneo (opcional)
EXCLUDE_DIRS=
