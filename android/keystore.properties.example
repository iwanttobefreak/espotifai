# Copia este fichero a keystore.properties (ignorado por git) y pon tus datos.
# Genera un keystore con:
#   keytool -genkeypair -v -keystore keystore/espotifai-release.jks \
#     -alias espotifai -keyalg RSA -keysize 2048 -validity 10000

storeFile=keystore/espotifai-release.jks
storePassword=CAMBIA_ESTO
keyAlias=espotifai
keyPassword=CAMBIA_ESTO
